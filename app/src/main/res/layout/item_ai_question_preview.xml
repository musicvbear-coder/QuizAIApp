<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvQuestionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"
            tools:text="Nội dung câu hỏi trắc nghiệm..." />

        <!-- Option A -->
        <LinearLayout
            android:id="@+id/layoutOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_option_normal"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvCircleA"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="A"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvOptionA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="14sp"
                tools:text="Nội dung đáp án A" />

            <ImageView
                android:id="@+id/imgCheckA"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#16A34A"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Option B -->
        <LinearLayout
            android:id="@+id/layoutOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_option_normal"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvCircleB"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="B"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvOptionB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="14sp"
                tools:text="Nội dung đáp án B" />

            <ImageView
                android:id="@+id/imgCheckB"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#16A34A"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Option C -->
        <LinearLayout
            android:id="@+id/layoutOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_option_normal"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvCircleC"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="C"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvOptionC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="14sp"
                tools:text="Nội dung đáp án C" />

            <ImageView
                android:id="@+id/imgCheckC"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#16A34A"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Option D -->
        <LinearLayout
            android:id="@+id/layoutOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_option_normal"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCircleD"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_circle_gray"
                android:gravity="center"
                android:text="D"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvOptionD"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0F172A"
                android:textSize="14sp"
                tools:text="Nội dung đáp án D" />

            <ImageView
                android:id="@+id/imgCheckD"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#16A34A"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Explanation -->
        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#475569"
            android:textSize="13sp"
            tools:text="Giải thích chi tiết..." />

    </LinearLayout>
</androidx.cardview.widget.CardView>