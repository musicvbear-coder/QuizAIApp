<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutActionButtons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#CBD5E1"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip_black_selected"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨  GEMINI AI"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đề thi AI đã tạo xong"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvExamInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    tools:text="Chủ đề: Mạng máy tính · 10 câu · Hỗn hợp · Gợi ý: 15 phút" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAiPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnLamBaiNgay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▶  Làm bài thi ngay"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            app:cornerRadius="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnXuatFileDeThi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📥  Xuất file đề thi"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#F1F5F9"
            app:cornerRadius="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLuuNganHang"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾  Lưu vào Ngân hàng câu hỏi"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#0F172A"
            app:cornerRadius="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTaoLai"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔄  Tạo lại"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:backgroundTint="#F1F5F9"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>