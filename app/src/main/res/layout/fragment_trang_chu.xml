<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_black_circle"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@android:color/white"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QuizMaster Mobile"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Exam Creator for Teachers"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#E2E8F0"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#0F172A"
                android:padding="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvUserInitials"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_black_circle"
                android:gravity="center"
                android:text="ĐKV"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Greeting Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xin chào,"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWelcomeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thầy Đặng Kỳ Vĩ 👋"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- AI Quiz Generator Card -->
        <LinearLayout
            android:id="@+id/cardOpenAiQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_black_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ TRỢ LÝ GEMINI AI · SINH ĐỀ NHANH"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Tạo đề thi tự động bằng AI"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập chủ đề bất kỳ hoặc tải tệp tài liệu để Gemini AI biên soạn câu hỏi trắc nghiệm kèm đáp án và lời giải chi tiết."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnGenerateAi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="✨  Bắt đầu tạo đề ngay  →"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                app:cornerRadius="20dp" />

        </LinearLayout>

        <!-- Join Room Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 Vào phòng thi bằng Mã"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/edtRoomCodeInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_gray_unselected"
                    android:hint="Nhập Mã phòng (VD: 839210)"
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Vào thi ▶"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0F172A"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- "Đề thi & Lịch sử gần đây" Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đề thi &amp; Lịch sử gần đây"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAllHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả &gt;"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent Exams RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRecentExams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_lich_su_de_thi" />

    </LinearLayout>
</ScrollView>