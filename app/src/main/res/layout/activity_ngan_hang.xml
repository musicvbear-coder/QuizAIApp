<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="20dp">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ngân hàng &amp; Lịch sử"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <!-- Nút Nhập File Word/TXT -->
        <Button
            android:id="@+id/btnImportFile"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="📥 Nhập File"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#0F172A"
            app:cornerRadius="10dp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Tab Toggle Buttons -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="#F1F5F9"
        android:padding="4dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerToolbar">

        <Button
            android:id="@+id/btnTabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📜 Lịch sử đề thi"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#0F172A"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnTabBank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏦 Ngân hàng câu hỏi"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có dữ liệu. Hãy tạo đề AI hoặc nhập file!"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView danh sách -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewNganHang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>