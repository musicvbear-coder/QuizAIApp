<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Difficulty & Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvQuestionDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_gray_unselected"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="Thông hiểu" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnDeleteQuestion"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#64748B"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Question content -->
        <TextView
            android:id="@+id/tvBankQuestionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="8dp"
            tools:text="Nội dung câu hỏi trắc nghiệm do AI tự động biên soạn..." />

        <!-- Correct answer -->
        <TextView
            android:id="@+id/tvBankCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#16A34A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            tools:text="Đáp án đúng: C. ..." />

        <!-- Subject info -->
        <TextView
            android:id="@+id/tvBankSubjectInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12sp"
            tools:text="Môn học · Chương" />

    </LinearLayout>
</androidx.cardview.widget.CardView>